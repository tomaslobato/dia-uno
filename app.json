{
  "expo": {
    "name": "mejordia",
    "slug": "mejordia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "scheme": "mejordia",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.lobato.mejordia"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a73e8",
        "foregroundImage": "./assets/branding/foreground.png",
        "monochromeImage": "./assets/branding/foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lobato.mejordia"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8fafd",
          "image": "./assets/branding/icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
