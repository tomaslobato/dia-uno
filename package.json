{
  "name": "dia-uno",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~57.0.31",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --android --go",
    "ios": "expo start --dev-client",
    "web": "expo start --web",
    "lint": "expo lint",
    "start:go": "expo start --go",
    "android:build": "expo run:android",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "emulator": "emulator -avd Expo_API_36 -gpu host -accel on -no-boot-anim",
    "build:android": "eas build --platform android --profile development",
    "build:ios": "eas build --platform ios --profile development",
    "build:apk": "eas build --platform android --profile preview",
    "build:apk:local": "expo prebuild --platform android && cd android && NODE_ENV=production ./gradlew assembleRelease --no-daemon --max-workers=2 && cd .. && mkdir -p artifacts && cp android/app/build/outputs/apk/release/app-release.apk artifacts/dia-uno.apk",
    "test": "node --test --test-isolation=none tests/*.test.mjs"
  },
  "private": true
}
